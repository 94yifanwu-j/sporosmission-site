---
/* YouTube embed. Renders a styled placeholder until a real videoId is set. */
interface Props {
  videoId?: string;
  title: string;
}

const { videoId = '', title } = Astro.props;
const isPlaceholder = !videoId || videoId.startsWith('TODO');
const src = `https://www.youtube.com/embed/${videoId}?rel=0`;
---

{
  isPlaceholder ? (
    <div class="video-16x9 yt-placeholder" role="img" aria-label={`${title}（影片待補）`}>
      <svg viewBox="0 0 24 24" width="56" height="56" fill="#fff" aria-hidden="true">
        <path d="M23 12s0-3.9-.5-5.6c-.3-1-1.1-1.8-2.1-2C18.6 4 12 4 12 4s-6.6 0-8.4.4c-1 .3-1.8 1-2.1 2C1 8.1 1 12 1 12s0 3.9.5 5.6c.3 1 1.1 1.8 2.1 2 1.8.4 8.4.4 8.4.4s6.6 0 8.4-.4c1-.3 1.8-1 2.1-2 .5-1.7.5-5.6.5-5.6ZM9.8 15.5v-7l6 3.5-6 3.5Z" />
      </svg>
      <span>{title}（影片待補）</span>
    </div>
  ) : (
    <div class="video-16x9">
      <iframe
        src={src}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      />
    </div>
  )
}

<style>
  .yt-placeholder {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--p-plum-800), var(--p-plum-950));
    border: 1px solid var(--color-border-dark);
    color: var(--color-on-dark-muted);
    font-size: 0.95rem;
  }

  .yt-placeholder svg {
    opacity: 0.85;
  }
</style>
