---
/* Hero — 歡迎來到施普絡世宣教中心 */
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-card">
      <p class="hero-eyebrow">歡迎來到 <span>Welcome to</span></p>
      <h1>
        施普絡世
        <br />
        宣教中心
      </h1>
      <p class="hero-en">Sporos Mission Church</p>
      <p class="hero-sub">聖地牙哥華人基督教會</p>
      <a class="btn" href="#give">施普絡世需要你的支持</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 253, 248, 0.62), rgba(255, 253, 248, 0.82)),
      url('/images/hero-bg.jpg') center 32% / cover no-repeat,
      linear-gradient(180deg, var(--p-sand-50), var(--p-sand-100));
    padding: clamp(4rem, 10vw, 7.5rem) 0;
  }

  .hero::before {
    /* subtle grain of light — pure CSS, no image dependency */
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(169, 38, 80, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(70% 70% at 50% 40%, black, transparent);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-card {
    text-align: center;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 1.75rem;
    box-shadow: var(--card-shadow);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 6vw, 4.5rem);
    max-width: 44rem;
  }

  .hero-eyebrow {
    font-size: 1.05rem;
    color: var(--color-muted);
    margin-bottom: var(--p-space-3);
  }

  .hero-eyebrow span {
    font-size: 0.85em;
  }

  .hero-card h1 {
    font-size: var(--text-hero);
    letter-spacing: 0.06em;
    margin-bottom: var(--p-space-2);
    background: linear-gradient(120deg, var(--p-rose-700), var(--p-rose-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-en {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--p-space-2);
  }

  .hero-sub {
    color: var(--color-muted);
    font-size: var(--text-lead);
    margin-bottom: var(--p-space-8);
  }
</style>
