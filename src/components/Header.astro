  { label: 'Blog', href: '/blog' },
  { label: '最新動向', sub: 'News & Events', href: '/#news' },
  { label: '講道', sub: 'Sermons', href: '/#watch' },
  { label: '時間地點', sub: 'Time & Location', href: '/#location' },
  { label: '週報', sub: 'Bulletin', href: '/bulletin' },
  { label: '奉獻', sub: 'Give', href: '/#give' },
];

const socials = [
  {
