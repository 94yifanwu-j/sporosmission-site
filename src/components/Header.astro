---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="施普絡世宣教中心 Sporos Mission Church 首頁">
      <img
        class="brand-logo"
        src="/images/logo.png"
        alt="施普絡世宣教中心 Logo"
        width="400"
        height="106"
      />
      <span class="brand-text">
        <strong>施普絡世宣教中心</strong>
        <small>Sporos Mission Church</small>
      </span>
    </a>

    <nav class="main-nav" aria-label="主選單">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
                {item.sub && <small>{item.sub}</small>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="socials">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={s.svg} />
          </a>
        ))
      }
    </div>

    <button class="menu-toggle" aria-label="開啟選單" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--header-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--p-space-6);
    padding-block: 0.7rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-ink);
    flex-shrink: 0;
  }

  .brand:hover {
    color: var(--color-ink);
  }

  .brand-logo {
    height: 2.6rem;
    width: auto;
    border-radius: 0.6rem;
    display: block;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .brand-text small {
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .main-nav {
    margin-left: auto;
  }

  .main-nav ul {
    display: flex;
    align-items: center;
    gap: var(--p-space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: var(--p-radius-sm);
    color: var(--color-ink-soft);
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.25;
    white-space: nowrap;
  }

  .main-nav a small {
    font-size: 0.68rem;
    color: var(--color-muted);
    font-weight: 400;
  }

  .main-nav a:hover {
    background: var(--color-brand-soft);
    color: var(--color-brand-strong);
  }

  .main-nav a:hover small {
    color: var(--color-brand-strong);
  }

  .socials {
    display: flex;
    gap: var(--p-space-2);
    align-items: center;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    transition: all var(--p-transition-fast);
  }

  .socials a:hover {
    color: #fff;
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  .menu-toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
  }

  @media (max-width: 1023px) {
    .main-nav,
    .site-header .socials {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .site-header.menu-open .main-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-surface);
      border-bottom: 1px solid var(--header-border);
      padding: var(--p-space-4);
    }

    .site-header.menu-open .main-nav ul {
      flex-direction: column;
      align-items: stretch;
    }

    .site-header.menu-open .main-nav a {
      align-items: flex-start;
      padding: 0.7rem 0.8rem;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(!!open));
    toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
  });
  header?.querySelectorAll('.main-nav a').forEach((a) => {
    a.addEventListener('click', () => {
      header.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
